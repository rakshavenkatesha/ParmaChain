# Server Port
PORT=5000

# MongoDB Database URI (Use local mongodb://localhost:27017/pharma or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/pharma-supply-chain

# JWT Secret
JWT_SECRET=YOUR_SUPER_SECRET_JWT_KEY_CHANGE_THIS

# Cloudinary Credentials (For storing license documents)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Nodemailer SMTP Configuration (For email notifications)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_smtp_username
EMAIL_PASS=your_smtp_password
EMAIL_FROM=noreply@pharmachain.com

# Blockchain RPC used by the chain indexer, proof server and explorer (read-only, no keys).
# Hardhat node and the Besu regulator validator both listen on :8545.
# If unset, the rpcUrl written by blockchain/scripts/deploy.js into contractDetails.json is used.
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# How often the indexer polls for new blocks (ms)
INDEXER_POLL_MS=2000
